# Environment Variables for Cozy Lagos

# API Configuration
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=10000
VITE_API_RETRIES=3

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# MongoDB Configuration (Server-side only)
MONGODB_URI=your_mongodb_uri
MONGODB_DB_NAME=cozy_lagos

# JWT Configuration (Server-side only)
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Environment
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SPEED_INSIGHTS=true
VITE_ENABLE_SERVICE_WORKER=true

# External Services
VITE_WHATSAPP_BUSINESS_ID=your_whatsapp_id
VITE_WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
